# ===== LINE Messaging API (จาก LINE Developers Console > Messaging API channel) =====
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ===== LIFF (แดชบอร์ดในแอป LINE) — สร้างใน LINE Login channel =====
LIFF_ID=
LINE_LOGIN_CHANNEL_ID=

# URL สาธารณะของเซิร์ฟเวอร์ (https) ใช้สร้างลิงก์แดชบอร์ด/ดาวน์โหลด และรูปโลโก้ใน Flex
BASE_URL=https://your-app.example.com

# ===== AI อ่านสลิป + เข้าใจประโยคยาว (ไม่ใส่ก็ใช้งานได้ แต่จะอ่านสลิปไม่ได้) =====
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# อื่นๆ
PORT=3000
APP_SECRET=change-me-to-a-long-random-string
# DATA_DIR=./data
# DEMO_MODE=false   # true = เปิดหน้าแชทจำลอง/แดชบอร์ดเดโม (ค่าเริ่มต้น: เปิดเมื่อยังไม่ใส่ LINE secret)
